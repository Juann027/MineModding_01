    "hitbox_width": 0.6,
    "render_scale": 1.0,
    "export": {
      "file": "respectcraft:animations/entity/your_fruit.animation.json",
      "animation_prefix": "animation.your_fruit.scene."
    }
  },
  "contacts": [
    {"event": "hit", "attacker_bone": "RightHandAttachment", "victim_bone": "socket_impact_point", "max_px": 10},
